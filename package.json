{
  "name": "NCE",
  "productName": "NCE",
  "version": "0.0.1-beta.1",
  "description": "",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sync-nsh-themes": "node scripts/sync-nsh-themes.js",
    "prestart": "npm run sync-nsh-themes",
    "prebuild": "npm run sync-nsh-themes",
    "start": "tsc && electron dist/main.js",
    "build": "electron-builder",
    "dist": "electron-builder --dir"
  },
  "author": "Andrea Belvedere",
  "license": "ISC",
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "chokidar": "^5.0.0",
    "markdown-it": "^15.0.0",
    "nsh": "github:developper259/NSH#4b5d48f341e06595cf04c80b77382f5a9a587ff9",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "fr.ndl.nce",
    "productName": "NCE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      {
        "from": "src/config/",
        "to": "config/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/js/",
        "to": "js/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/html/",
        "to": "html/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/css/",
        "to": "css/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo/NCE/dark-logo.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/logo/NCE/dark-logo.icns"
    },
    "linux": {
      "icon": "assets/logo/NCE/dark-logo.png"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
