{
  "name": "NCE",
  "productName": "NCE",
  "desktopName": "fr.ndl.nce.desktop",
  "version": "0.0.1-beta.4",
  "description": "A lightweight and fast desktop code editor built from scratch.",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync-assets && npm run build:main && npm run build:renderer",
    "sync-assets": "node scripts/sync-assets.js",
    "sync-nsh-themes": "npm run sync-assets",
    "prestart": "npm run sync-assets",
    "prebuild": "npm run sync-assets",
    "build:main": "tsc",
    "build:renderer": "vite build --config vite.config.mjs",
    "start": "npm run build:main && npm run rebuild:native && node scripts/start-dev.js",
    "build": "npm run build:main && npm run build:renderer && npm run rebuild:native && electron-builder --publish never",
    "dist": "npm run sync-assets && npm run build:main && npm run build:renderer && npm run rebuild:native && electron-builder --dir --publish never",
    "check": "npm run typecheck && npm test",
    "rebuild:native": "electron-rebuild -f -w node-pty && node node_modules/node-pty/scripts/post-install.js",
    "test:electron": "npm run sync-assets && npm run build:main && npm run build:renderer && npm run rebuild:native && node --test tests/electron/smoke.cjs",
    "test:packaged": "node scripts/check-package.js"
  },
  "author": {
    "name": "Andrea Belvedere",
    "email": "andreablv.collab@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "chokidar": "^5.0.0",
    "markdown-it": "^15.0.0",
    "node-pty": "1.2.0-beta.15",
    "nsh": "github:developper259/NSH#4b5d48f341e06595cf04c80b77382f5a9a587ff9"
  },
  "build": {
    "appId": "fr.ndl.nce",
    "productName": "NCE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/logo/NCE/dark-logo.png",
      "!node_modules/node-pty/prebuilds/**/*",
      "package.json",
      {
        "from": "src/js/main/",
        "to": "js/main/",
        "filter": [
          "Preload.js"
        ]
      }
    ],
    "asarUnpack": ["node_modules/node-pty/build/Release/**/*"],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/logo/NCE/dark-logo.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/logo/NCE/dark-logo.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/logo/NCE/dark-logo.png",
      "category": "Development",
      "syncDesktopName": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "8.5.28",
    "typescript": "^5.2.2",
    "vite": "^8.3.2"
  }
}
