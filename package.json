{
  "name": "NCE",
  "productName": "NCE",
  "desktopName": "fr.ndl.nce.desktop",
  "version": "0.0.1-beta.2",
  "description": "A lightweight and fast desktop code editor built from scratch.",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync-assets && npm run build:main",
    "sync-assets": "node scripts/sync-assets.js",
    "sync-nsh-themes": "npm run sync-assets",
    "prestart": "npm run sync-assets",
    "prebuild": "npm run sync-assets",
    "build:main": "tsc",
    "start": "npm run build:main && electron dist/main.js",
    "build": "npm run build:main && electron-builder --publish never",
    "dist": "npm run sync-assets && npm run build:main && electron-builder --dir --publish never",
    "check": "npm run typecheck && npm test",
    "test:electron": "npm run sync-assets && npm run build:main && node --test tests/electron/smoke.cjs",
    "test:packaged": "node scripts/check-package.js"
  },
  "author": {
    "name": "Andrea Belvedere",
    "email": "andreablv.collab@gmail.com"
  },
  "license": "ISC",
  "dependencies": {
    "chokidar": "^5.0.0",
    "markdown-it": "^15.0.0",
    "nsh": "github:developper259/NSH#4b5d48f341e06595cf04c80b77382f5a9a587ff9"
  },
  "build": {
    "appId": "fr.ndl.nce",
    "productName": "NCE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      {
        "from": "src/config/",
        "to": "config/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/js/",
        "to": "js/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/html/",
        "to": "html/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/css/",
        "to": "css/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/logo/NCE/dark-logo.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "assets/logo/NCE/dark-logo.icns"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/logo/NCE/dark-logo.png",
      "category": "Development",
      "syncDesktopName": true
    }
  },
  "devDependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.2.2"
  }
}
