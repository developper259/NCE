{
  "schemaVersion": 1,
  "defaultMode": "quick",
  "defaultTimeoutMs": 30000,
  "applicationCloseTimeoutMs": 10000,
  "profileRoot": ".benchmark-data/ide/profiles",
  "resultsRoot": ".benchmark-data/ide/results",
  "fixtureRoot": ".benchmark-data/ide/fixtures",
  "modes": {
    "quick": {
      "startupSamples": 3,
      "warmupSamples": 0,
      "scenarios": [
        "startup.cold-ish", "file.open.small", "file.open.medium",
        "file.open.long-line-100k", "tabs.switch", "editor.typing",
        "scroll.vertical", "scroll.horizontal", "editor.search", "idle.activity"
      ]
    },
    "standard": {
      "startupSamples": 5,
      "warmupSamples": 1,
      "scenarios": [
        "startup.cold-ish", "workspace.open.small", "file.open.tiny",
        "file.open.small", "file.open.medium", "file.open.large", "file.open.binary",
        "file.open.10kb", "file.open.100kb", "file.open.1mb",
        "file.open.long-line-100k", "tabs.open", "tabs.switch", "tabs.close",
        "editor.typing", "editor.backspace", "editor.enter", "editor.cursor",
        "editor.select-all", "editor.copy-selection", "editor.search", "editor.search-many-results",
        "scroll.vertical", "scroll.horizontal", "editor.syntax-highlight",
        "memory.open-close-small", "renderer.raf-cadence", "idle.activity", "dom.count"
      ]
    },
    "full": {
      "startupSamples": 10,
      "warmupSamples": 2,
      "scenarios": [
        "startup.cold-ish", "workspace.open.small", "workspace.open.medium",
        "workspace.open.large", "file.open.tiny", "file.open.small",
        "file.open.medium", "file.open.large", "file.open.very-large", "file.open.binary",
        "file.open.extreme", "file.open.10kb", "file.open.100kb",
        "file.open.1mb", "file.open.5mb", "file.open.10mb", "file.open.50mb", "file.open.long-line-10k",
        "file.open.long-line-100k", "file.open.long-line-1m",
        "file.open.long-line-tabs-1m", "file.open.long-unicode",
        "tabs.open", "tabs.switch", "tabs.close", "tabs.close-all",
        "editor.typing", "editor.backspace", "editor.enter", "editor.cursor",
        "editor.select-all", "editor.select-all-large", "editor.select-all-long-line",
        "editor.copy-selection", "editor.copy-large-selection", "editor.search",
        "editor.search-many-results", "editor.search-long-line",
        "scroll.vertical", "scroll.horizontal", "scroll.horizontal.tabs-1m",
        "scroll.horizontal.unicode", "editor.syntax-highlight",
        "memory.open-close-large", "memory.open-close-long-line", "memory.repeated-open-close",
        "renderer.raf-cadence", "idle.activity", "dom.count", "dom.count-large", "dom.count-long-line"
      ]
    }
  },
  "iterations": {
    "quick": { "interaction": 3, "open": 2, "memory": 2 },
    "standard": { "interaction": 10, "open": 5, "memory": 5 },
    "full": { "interaction": 30, "open": 10, "memory": 10 }
  },
  "scenarioTimeoutsMs": {
    "workspace.open.large": 90000,
    "file.open.large": 60000,
    "file.open.very-large": 90000,
    "file.open.extreme": 120000,
    "file.open.long-line-1m": 90000,
    "file.open.long-line-tabs-1m": 90000,
    "file.open.long-unicode": 90000,
    "file.open.5mb": 60000,
    "file.open.10mb": 90000,
    "file.open.50mb": 120000,
    "workspace.open.medium": 60000,
    "editor.select-all-large": 60000,
    "editor.select-all-long-line": 90000,
    "editor.copy-large-selection": 120000,
    "editor.search-long-line": 120000,
    "scroll.horizontal": 60000,
    "scroll.horizontal.tabs-1m": 90000,
    "scroll.horizontal.unicode": 60000,
    "dom.count-large": 60000,
    "dom.count-long-line": 60000,
    "memory.open-close-large": 90000,
    "memory.open-close-long-line": 90000,
    "memory.repeated-open-close": 90000
  },
  "safety": {
    "extremeWorkspaceRequiresFlag": true,
    "maxWorkspaceEntriesByDefault": 20000,
    "maxFixtureFileBytes": 52428800,
    "maxOpenTabs": 100,
    "requireExplicitExtremeFor100kWorkspace": true
  }
}
